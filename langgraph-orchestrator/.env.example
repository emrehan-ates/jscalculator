# --- Authentication (users.py / tokens.py / signup.py) -----------------------
# Admin account. Created on first start; changing ADMIN_PASSWORD and restarting
# updates the stored bcrypt hash and logs out existing admin sessions.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_EMAIL=ZTMAY1DatacenterNetwork@ziraatteknoloji.com
ADMIN_TEAM=MAY1

# Signing key of the app session JWT (>= 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=
APP_JWT_TTL_HOURS=12

# Chainlit's own login cookie key (also >= 32 chars, can be generated the same way).
CHAINLIT_AUTH_SECRET=

# SQLite file of the user store.
USERS_DB=/root/langgraph-orchestrator/users.db

# --- Mail (signup / approval notifications) ----------------------------------
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURITY=none
SMTP_FROM=networkgpt@ziraatteknoloji.com

# --- VLAN Desk API (define_epg: free VLANs + "in use" reservations) ---------
VLAN_API_URL=http://10.6.107.105:8003
VLAN_API_USERNAME=
VLAN_API_PASSWORD=
VLAN_API_TIMEOUT=15
# VLAN API environment id per chat-profile fabric:
#   APIC_EVM_BANKA | APIC_EVM_ISTIRAK | APIC_KKB_BANKA | APIC_KKB_ISTIRAK
FABRIC_1_VLAN_SOURCE=
# FABRIC_2_VLAN_SOURCE=
# Single-fabric setups (no FABRIC_<n>_* variables):
# VLAN_SOURCE=
