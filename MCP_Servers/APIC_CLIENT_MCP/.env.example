# APIC connection details
APIC_HOST=https://10.7.107.12/
APIC_USERNAME=admin
APIC_PASSWORD=Fnbl2002!

# Optional: SSL verification. APIC genelde self-signed sertifika kullanır,
# bu yüzden default false. Production CA-signed sertifika varsa true yap.
APIC_VERIFY_SSL=false

# Optional: HTTP request timeout in seconds
APIC_TIMEOUT=30

# Optional: how long before token expiry to proactively refresh (seconds)
# APIC default token TTL = 600s, refresh 60s before = 540s session usage
APIC_REFRESH_BEFORE=60
